&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;她&lt;/td&gt;
&lt;td&gt;かのじょ&lt;/td&gt;
&lt;td&gt;kanojo&lt;/td&gt;
&lt;td&gt;彼女&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;他們&lt;/td&gt;
&lt;td&gt;かれら&lt;/td&gt;
&lt;td&gt;karera&lt;/td&gt;
&lt;td&gt;彼ら&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;她們&lt;/td&gt;
&lt;td&gt;かのじょたち&lt;/td&gt;
